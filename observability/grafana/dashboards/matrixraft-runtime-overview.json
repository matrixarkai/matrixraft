        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rustraft_append_latency_ms_bucket[5m])))",
          "legendFormat": "__auto",
          "refId": "A"
